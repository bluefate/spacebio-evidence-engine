# Copy to .env and adjust locally. Do not commit real secrets.

# PostgreSQL / pgvector
POSTGRES_DB=spacebio
POSTGRES_USER=spacebio
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://spacebio:change-me-locally@localhost:5432/spacebio

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Model providers (optional; leave unset for local-only / $0 cloud mode)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

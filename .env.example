# Copy to .env and adjust locally. Do not commit real secrets.
# Reference: docs/operations/LOCAL_SETUP.md (issue #6)

# --- Required for local Postgres / pgvector ---
POSTGRES_DB=spacebio
POSTGRES_USER=spacebio
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# SQLAlchemy URL used by the API and bootstrap script (psycopg3 driver).
# Keep the password segment aligned with POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://spacebio:change-me-locally@localhost:5432/spacebio

# Bootstrap:
#   make setup         # first-time: .env, venv, deps, Compose, migrate
#   make setup-check   # dry-run checklist (no secrets printed)
#   make services      # start Compose Postgres (pgvector image)
#   make db-bootstrap  # CREATE EXTENSION IF NOT EXISTS vector (idempotent)
#   make migrate       # Alembic upgrade head
# Fresh volumes also run scripts/db/init/*.sql via docker-entrypoint-initdb.d.

# --- Application (required defaults) ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Web -> FastAPI backend URL (used by the Next.js /api/ask route handler)
SPACEBIO_API_URL=http://localhost:8000

# --- PDF storage (issue #28) ---
PDF_STORAGE_BACKEND=local
PDF_STORAGE_LOCAL_ROOT=data/pdfs

# --- Optional model providers (leave unset for local-only / $0 cloud mode) ---
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI embeddings (issue #41). Provider stays disabled unless
# OPENAI_API_KEY is set locally; never commit real keys.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Local embeddings (issue #40). Install weights stack with:
#   pip install -e ".[embeddings]"
# First run downloads the model into the Hugging Face cache (~90MB for MiniLM).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval observability (issue #49) ---
# Structured logs omit raw queries, prompts, secrets, API keys, provider
# responses, and chunk text.
SPACEBIO_RETRIEVAL_LOGGING_ENABLED=true
SPACEBIO_RETRIEVAL_VERBOSE_LOGS=false

# --- Developer retrieval diagnostics (issue #67; off by default) ---
# Enable both flags to show /dev/retrieval and POST /dev/retrieval-diagnostics.
# Leave unset/false so the view 404s and is hidden from the home page.
# SPACEBIO_DEV_RETRIEVAL_DIAGNOSTICS=false
# NEXT_PUBLIC_ENABLE_RETRIEVAL_DIAGNOSTICS=false

# Copy to .env and adjust locally. Do not commit real secrets.

# PostgreSQL / pgvector (Docker Compose service `db`)
POSTGRES_DB=spacebio
POSTGRES_USER=spacebio
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# SQLAlchemy URL used by the API and bootstrap script (psycopg3 driver).
DATABASE_URL=postgresql+psycopg://spacebio:change-me-locally@localhost:5432/spacebio

# Bootstrap:
#   make services      # start Compose Postgres (pgvector image)
#   make db-bootstrap  # CREATE EXTENSION IF NOT EXISTS vector (idempotent)
#   make migrate       # Alembic upgrade head (publications table; issue #27)
# Fresh volumes also run scripts/db/init/*.sql via docker-entrypoint-initdb.d.

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PDF storage (issue #28)
PDF_STORAGE_BACKEND=local
PDF_STORAGE_LOCAL_ROOT=data/pdfs

# Model providers (optional; leave unset for local-only / $0 cloud mode)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Local embeddings (issue #40). Install weights stack with:
#   pip install -e ".[embeddings]"
# First run downloads the model into the Hugging Face cache (~90MB for MiniLM).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
